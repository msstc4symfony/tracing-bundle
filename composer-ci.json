{
  "name": "msstc4symfony/tracing-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Maxim Shamaev",
      "email": "maxim.shamaev@gmail.com"
    }
  ],
  "type": "symfony-bundle",
  "description": "Request tracing for Symfony (CI profile — installs optional libraries and CI-only tools)",
  "minimum-stability": "stable",
  "keywords": ["php", "symfony", "tracing"],
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Msstc4Symfony\\TracingBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Msstc4Symfony\\TracingBundle\\Test\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.4",
    "composer-runtime-api": ">=2.2",
    "monolog/monolog": "^3.5",
    "symfony/console": "^6.4|^7.0|^8.0",
    "symfony/event-dispatcher": "^6.4|^7.0|^8.0",
    "symfony/framework-bundle": "^6.4|^7.0|^8.0",
    "symfony/uid": "^6.4|^7.0|^8.0"
  },
  "require-dev": {
    "deptrac/deptrac": "^4.6",
    "friendsofphp/php-cs-fixer": "^3.55",
    "guzzlehttp/guzzle": "^7.8",
    "infection/infection": "^0.32",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": ">=11.0",
    "rector/rector": "^2.1",
    "roave/backward-compatibility-check": "^8.20",
    "roave/security-advisories": "dev-latest",
    "sentry/sentry": "^4.10",
    "symfony/http-client": "^6.4|^7.0|^8.0",
    "symfony/messenger": "^6.4|^7.0|^8.0",
    "symfony/monolog-bundle": "^3.11|^4.0"
  },
  "suggest": {
    "guzzlehttp/guzzle": "To propagate the trace through Guzzle clients",
    "sentry/sentry": "To attach the trace to Sentry events (TracingIntegration)",
    "symfony/http-client": "To propagate the trace through Symfony HttpClient",
    "symfony/messenger": "To propagate the trace through Messenger messages",
    "symfony/monolog-bundle": "To add the trace to every log record"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true,
      "php-http/discovery": false,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "^6.4|^7.0|^8.0"
    }
  }
}
